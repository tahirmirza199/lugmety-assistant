<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local Room database from cloud backup to protect user privacy -->
        <exclude domain="database" path="lugmety_assistant.db" />
        <exclude domain="database" path="lugmety_assistant.db-shm" />
        <exclude domain="database" path="lugmety_assistant.db-wal" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude local Room database from unencrypted device transfer -->
        <exclude domain="database" path="lugmety_assistant.db" />
        <exclude domain="database" path="lugmety_assistant.db-shm" />
        <exclude domain="database" path="lugmety_assistant.db-wal" />
    </device-transfer>
</data-extraction-rules>
